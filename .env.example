# GrowthOS Environment Configuration
ENVIRONMENT=development
PORT=8000
SECRET_KEY=growthos-super-secret-key-change-in-production

# Database (defaults to SQLite fallback if PostgreSQL not configured)
DATABASE_URL=sqlite:///./growthos.db
# DATABASE_URL=postgresql://growthos:growthos_pass@localhost:5432/growthos_db

# Paytm Provider Integration
# Options: 'mock' (default, 100% offline deterministic) or 'live'
PAYTM_PROVIDER=mock
PAYTM_MERCHANT_ID=MERCH_PUNE_001
PAYTM_API_KEY=
PAYTM_WEBHOOK_SECRET=

# Multilingual AI Voice Layer (Sarvam AI)
# Options: 'mock' (deterministic speech simulation) or 'live'
SARVAM_PROVIDER=mock
SARVAM_API_KEY=

# Cognitive Memory & Graph (Cognee)
# Options: 'local' (deterministic SQLite graph) or 'cognee_cloud'
COGNEE_PROVIDER=local
COGNEE_API_KEY=

# Workflow Execution Engine (n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/growthos-action
N8N_API_KEY=

# Safe Language & Guardrails
ENABLE_STRICT_SAFE_LANGUAGE=true
MAX_ALLOWABLE_PROMO_DISCOUNT_PCT=25.0
